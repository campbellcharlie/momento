{
  "name": "momento-mcp",
  "version": "0.1.0",
  "description": "MCP server that indexes and queries Claude Code conversation history at ~/.claude/projects/",
  "type": "module",
  "license": "MIT",
  "bin": {
    "momento": "dist/server.js",
    "momento-inject": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "inject": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "tsc && node --test 'test/*.test.js'",
    "pretest": "tsc"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
