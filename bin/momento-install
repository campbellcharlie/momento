#!/usr/bin/env bash
# Idempotent installer for momento's Claude Code and/or Cursor integration.
#
# Claude Code (~/.claude/settings.json):
#   1. MCP server entry "momento" -> node <abs>/dist/server.js
#   2. UserPromptSubmit hook -> node <abs>/dist/cli.js
#
# Cursor / cursor-agent (~/.cursor/mcp.json + ~/.cursor/hooks.json):
#   1. MCP server "momento" (skipped if "marshal" already aggregates the fleet)
#   2. sessionStart hook -> node <abs>/dist/cli.js (JSON additional_context)
#
# Re-runs are safe: existing entries are deduped by command-string match
# (so editing this script's path and re-running won't create duplicates,
# and another tool's hook with a different command stays untouched).
#
# Flags:
#   --dry-run       print the planned config without writing
#   --no-hook       install the MCP server but skip the auto-injection hook
#   --no-mcp        install the hook only, skip the MCP server entry
#   --claude        install Claude Code integration (default if neither target set)
#   --cursor        install Cursor / cursor-agent integration
#   --settings PATH override ~/.claude/settings.json target (for tests)
#   --mcp-path PATH override ~/.cursor/mcp.json (for tests)
#   --hooks-path PATH override ~/.cursor/hooks.json (for tests)
#
# Exit codes:
#   0  success (or dry-run)
#   1  precondition failed (missing node, missing build artifacts)
#   2  invalid argument
#
# Patterns lifted from lsp_kit's install.sh — see project_improvements.md.

set -euo pipefail

DRY_RUN=0
INSTALL_HOOK=1
INSTALL_MCP=1
INSTALL_CLAUDE=0
INSTALL_CURSOR=0
SETTINGS_PATH="${HOME}/.claude/settings.json"
MCP_PATH="${HOME}/.cursor/mcp.json"
HOOKS_PATH="${HOME}/.cursor/hooks.json"

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --no-hook) INSTALL_HOOK=0; shift ;;
    --no-mcp) INSTALL_MCP=0; shift ;;
    --claude) INSTALL_CLAUDE=1; shift ;;
    --cursor) INSTALL_CURSOR=1; shift ;;
    --settings) SETTINGS_PATH="$2"; shift 2 ;;
    --mcp-path) MCP_PATH="$2"; shift 2 ;;
    --hooks-path) HOOKS_PATH="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *)
      echo "momento-install: unknown arg: $1" >&2
      echo "run with --help for usage" >&2
      exit 2 ;;
  esac
done

# Default target: Claude, matching historical behavior.
if [ "$INSTALL_CLAUDE" = "0" ] && [ "$INSTALL_CURSOR" = "0" ]; then
  INSTALL_CLAUDE=1
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
MOMENTO_DIR=$(cd "$SCRIPT_DIR/.." && pwd)
SERVER_JS="$MOMENTO_DIR/dist/server.js"
CLI_JS="$MOMENTO_DIR/dist/cli.js"
MERGER="$SCRIPT_DIR/_merge-settings.mjs"
CURSOR_MERGER="$SCRIPT_DIR/_merge-cursor.mjs"

if [ "$INSTALL_MCP" = "1" ] && [ ! -f "$SERVER_JS" ]; then
  echo "momento-install: $SERVER_JS not found. Run 'npm run build' first." >&2
  exit 1
fi
if [ "$INSTALL_HOOK" = "1" ] && [ ! -f "$CLI_JS" ]; then
  echo "momento-install: $CLI_JS not found. Run 'npm run build' first." >&2
  exit 1
fi
if ! command -v node >/dev/null 2>&1; then
  echo "momento-install: node not on PATH" >&2
  exit 1
fi
if [ "$INSTALL_CLAUDE" = "1" ] && [ ! -f "$MERGER" ]; then
  echo "momento-install: missing $MERGER" >&2
  exit 1
fi
if [ "$INSTALL_CURSOR" = "1" ] && [ ! -f "$CURSOR_MERGER" ]; then
  echo "momento-install: missing $CURSOR_MERGER" >&2
  exit 1
fi

install_claude() {
  mkdir -p "$(dirname "$SETTINGS_PATH")"
  local planned
  planned=$(
    SETTINGS_PATH="$SETTINGS_PATH" \
    SERVER_JS="$SERVER_JS" \
    CLI_JS="$CLI_JS" \
    INSTALL_HOOK="$INSTALL_HOOK" \
    INSTALL_MCP="$INSTALL_MCP" \
    node "$MERGER"
  )
  if [ "$DRY_RUN" = "1" ]; then
    echo "# would write to $SETTINGS_PATH:"
    printf '%s\n' "$planned"
    return 0
  fi
  if [ -f "$SETTINGS_PATH" ]; then
    cp "$SETTINGS_PATH" "$SETTINGS_PATH.bak"
  fi
  printf '%s\n' "$planned" > "$SETTINGS_PATH"

  local state_dir="${HOME}/.claude/state"
  local state_file="$state_dir/momento-installed"
  mkdir -p "$state_dir"
  printf 'momento_dir=%s\nserver_js=%s\ncli_js=%s\nhook=%s\nmcp=%s\ninstalled_at=%s\n' \
    "$MOMENTO_DIR" "$SERVER_JS" "$CLI_JS" "$INSTALL_HOOK" "$INSTALL_MCP" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "$state_file"

  echo "momento-install: wrote $SETTINGS_PATH"
  [ -f "$SETTINGS_PATH.bak" ] && echo "momento-install: backup at $SETTINGS_PATH.bak"
  [ "$INSTALL_MCP" = "1" ] && echo "  - mcp server 'momento' -> $SERVER_JS"
  [ "$INSTALL_HOOK" = "1" ] && echo "  - UserPromptSubmit hook -> $CLI_JS"
  echo "momento-install: state recorded at $state_file"
}

install_cursor() {
  mkdir -p "$(dirname "$MCP_PATH")" "$(dirname "$HOOKS_PATH")"
  local planned mcp_json hooks_json
  planned=$(
    MCP_PATH="$MCP_PATH" \
    HOOKS_PATH="$HOOKS_PATH" \
    SERVER_JS="$SERVER_JS" \
    CLI_JS="$CLI_JS" \
    INSTALL_HOOK="$INSTALL_HOOK" \
    INSTALL_MCP="$INSTALL_MCP" \
    node "$CURSOR_MERGER"
  )
  if [ "$DRY_RUN" = "1" ]; then
    echo "# would write Cursor config:"
    printf '%s\n' "$planned"
    return 0
  fi

  mcp_json=$(printf '%s\n' "$planned" | node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{const j=JSON.parse(s); if(j.mcp) process.stdout.write(JSON.stringify(j.mcp,null,2)+"\n")})')
  hooks_json=$(printf '%s\n' "$planned" | node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{const j=JSON.parse(s); if(j.hooks) process.stdout.write(JSON.stringify(j.hooks,null,2)+"\n")})')

  if [ -n "$mcp_json" ]; then
    [ -f "$MCP_PATH" ] && cp "$MCP_PATH" "$MCP_PATH.bak"
    printf '%s\n' "$mcp_json" > "$MCP_PATH"
    echo "momento-install: wrote $MCP_PATH"
    if printf '%s' "$mcp_json" | node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{const j=JSON.parse(s); process.exit(j.mcpServers&&j.mcpServers.momento?0:1)})'; then
      echo "  - mcp server 'momento' -> $SERVER_JS"
    else
      echo "  - mcp: skipped direct momento (marshal already present)"
    fi
  fi
  if [ -n "$hooks_json" ]; then
    [ -f "$HOOKS_PATH" ] && cp "$HOOKS_PATH" "$HOOKS_PATH.bak"
    printf '%s\n' "$hooks_json" > "$HOOKS_PATH"
    echo "momento-install: wrote $HOOKS_PATH"
    [ "$INSTALL_HOOK" = "1" ] && echo "  - sessionStart hook -> $CLI_JS"
  fi

  local state_dir="${HOME}/.cursor"
  local state_file="$state_dir/momento-installed"
  printf 'momento_dir=%s\nserver_js=%s\ncli_js=%s\nhook=%s\nmcp=%s\ninstalled_at=%s\n' \
    "$MOMENTO_DIR" "$SERVER_JS" "$CLI_JS" "$INSTALL_HOOK" "$INSTALL_MCP" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "$state_file"
  echo "momento-install: state recorded at $state_file"
}

[ "$INSTALL_CLAUDE" = "1" ] && install_claude
[ "$INSTALL_CURSOR" = "1" ] && install_cursor
